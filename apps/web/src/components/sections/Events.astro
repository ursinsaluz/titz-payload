---
import { getCollection, mediaSrcSet, mediaUrl } from '../../lib/payload'
import { anlassPfad } from '../../lib/schema'
import Icon from '../Icon.astro'
import Egg from '../Egg.astro'
import type { Block } from '../../lib/blocks'

interface Props {
  block: Block<'eventsSection'>
}

const { block } = Astro.props
const alle = await getCollection('events', `&sort=datum&where[_status][equals]=published`)

const WOCHENTAGE: Record<string, string> = {
  Monday: 'Montag',
  Tuesday: 'Dienstag',
  Wednesday: 'Mittwoch',
  Thursday: 'Donnerstag',
  Friday: 'Freitag',
  Saturday: 'Samstag',
  Sunday: 'Sonntag',
}

/**
 * Was noch kommt. Der Filter läuft zur Bauzeit — das Frontend ist statisch, es
 * gibt im Browser keinen Code, der ein Datum vergleichen könnte. Ein Build
 * passiert bei jeder Inhaltsänderung; wer wochenlang nichts speichert, hat
 * einen abgelaufenen Termin stehen. Der Weg dagegen wäre ein täglicher Cron auf
 * den Deploy-Hook, nicht eine Prüfung im Browser: Was im HTML steht, ist das,
 * was Google sieht.
 *
 * Wöchentliche Anlässe bleiben immer stehen — sie haben kein Ablaufdatum.
 */
const heute = new Date()
heute.setUTCHours(0, 0, 0, 0)

const kommende = alle
  .filter((e) => {
    if (e.rhythmus === 'woechentlich') return true
    if (!e.datum) return false
    return new Date(e.datum) >= heute
  })
  // Wiederkehrendes zuerst: Es ist das verlässliche Angebot, ein einzelner
  // Termin die Ausnahme.
  .sort((a, b) => {
    if (a.rhythmus !== b.rhythmus) return a.rhythmus === 'woechentlich' ? -1 : 1
    return String(a.datum ?? '').localeCompare(String(b.datum ?? ''))
  })
  .slice(0, block.limit ?? 4)

const datumsText = (e: (typeof kommende)[number]) => {
  if (e.rhythmus === 'woechentlich') {
    const tag = e.wochentag ? WOCHENTAGE[e.wochentag] : null
    return tag ? `Jeden ${tag}` : 'Wöchentlich'
  }
  if (!e.datum) return null
  const d = new Date(e.datum)
  const pad = (n: number) => String(n).padStart(2, '0')
  return `${pad(d.getUTCDate())}.${pad(d.getUTCMonth() + 1)}.${d.getUTCFullYear()}`
}
---

{
  kommende.length > 0 && (
    <section class="events" id={block.anchor ?? 'anlaesse'}>
      <Egg
        name="lauch"
        size={58}
        bg="var(--kraut)"
        pos="right:7%;top:22%"
        anim="tzSway 7.2s ease-in-out infinite 0.4s"
      />
      <div class="events__inner">
        <div class="section-head">
          {block.eyebrow && <div class="eyebrow">{block.eyebrow}</div>}
          <h2>{block.heading}</h2>
          {block.intro && <p class="events__intro">{block.intro}</p>}
        </div>

        <div class="events__list">
          {kommende.map((e) => {
            const bild = mediaUrl(e.image, { breite: 320 })
            const responsiv = mediaSrcSet(e.image, 320)
            return (
              <article class={`event${e.rhythmus === 'woechentlich' ? ' event--fix' : ''}`}>
                <div class="event__when">
                  <span class="event__day">{datumsText(e)}</span>
                  {e.zeit && <span class="event__time">ab {e.zeit}</span>}
                </div>

                <div class="event__main">
                  {e.eyebrow && <div class="event__eyebrow">{e.eyebrow}</div>}
                  <h3 class="event__title">
                    {e.icon && <Icon icon={e.icon} class="event__icon" />}
                    <a href={anlassPfad(e.slug)}>{e.title}</a>
                  </h3>
                  <p class="event__text">{e.excerpt}</p>

                  {e.menu && e.menu.length > 0 && (
                    <ul class="event__menu">
                      {e.menu.map((gang) => (
                        <li>{gang.text}</li>
                      ))}
                    </ul>
                  )}

                  <div class="event__foot">
                    {e.preis && <span class="event__price">{e.preis}</span>}
                    {e.ort && <span class="event__place">{e.ort}</span>}
                    <a class="event__cta" href={anlassPfad(e.slug)}>
                      Details <span aria-hidden="true">→</span>
                    </a>
                    {e.cta?.url && (
                      <a class="event__cta" href={e.cta.url}>
                        {e.cta.label ?? 'Reservieren'} <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </div>
                </div>

                {bild && (
                  <img
                    class="event__img"
                    src={bild}
                    srcset={responsiv?.srcset}
                    sizes={responsiv?.sizes}
                    alt={typeof e.image === 'object' ? (e.image?.alt ?? '') : ''}
                    width="320"
                    height="220"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </article>
            )
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  .events {
    position: relative;
    padding: 90px 40px 34px;
    background: var(--bg);
  }

  .events__inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .events__intro {
    max-width: 60ch;
    margin: 12px auto 0;
    color: var(--ink-muted);
  }

  .events__list {
    display: grid;
    gap: 20px;
    margin-top: 42px;
  }

  .event {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 0 26px;
    align-items: start;
    background: #fff;
    border: 1.5px solid var(--rule);
    border-radius: 22px;
    padding: 26px 28px;
    transition:
      transform 250ms,
      box-shadow 250ms;
  }

  .event:hover {
    transform: translateY(-4px);
    box-shadow: 0 13px 34px rgba(47, 53, 56, 0.08);
  }

  /* Der wiederkehrende Anlass ist das verlässliche Angebot — er trägt die
     Markenfarbe, einzelne Termine bleiben ruhig. */
  .event--fix {
    background: var(--mint);
    border-color: var(--mint-deep);
  }

  .event__when {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 2px;
  }

  .event__day {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
    color: var(--green);
  }

  .event__time {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .event__eyebrow {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 6px;
  }

  .event__title a {
    transition: color 200ms;
  }

  .event__title a:hover {
    color: var(--green);
  }

  .event__title {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    font-size: 19px;
    line-height: 1.3;
  }

  .event__icon {
    display: inline-flex;
    width: 20px;
    height: 20px;
    color: var(--green);
    flex: 0 0 auto;
  }

  .event__text {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .event__menu {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
  }

  .event__menu li {
    font-size: 12px;
    padding: 4px 11px;
    border-radius: 20px;
    background: rgba(47, 53, 56, 0.05);
    color: var(--ink-muted);
  }

  .event__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 16px;
    font-size: 12.5px;
  }

  .event__price {
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .event__place {
    color: var(--ink-muted);
  }

  .event__cta {
    margin-left: auto;
    font-weight: 500;
    color: var(--green);
    transition: color 200ms;
  }

  .event__cta:hover {
    color: var(--gold);
  }

  .event__img {
    grid-column: 1 / -1;
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 14px;
    margin-top: 20px;
  }

  @media (max-width: 640px) {
    .events {
      padding: 70px 20px 24px;
    }

    .event {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 22px 20px;
    }

    .event__when {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }

    .event__cta {
      margin-left: 0;
    }
  }
</style>
