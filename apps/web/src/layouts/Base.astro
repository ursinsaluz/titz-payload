---
import { getEggData, getGlobal, ogBild, type Page } from '../lib/payload'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { PAYLOAD_ORIGIN } from '../lib/payload'

interface Props {
  /** Die SEO-Gruppe der Seite, direkt aus dem Content-Modell — vorher hier
      nachgebaut und mit `as never` übergeben. */
  seo?: Page['seo']
  pageTitle?: string
  /** Strukturierte Daten. Nur die Startseite hat welche; Impressum und
      Datenschutz brauchen keine und bekommen darum keine leere Angabe. */
  jsonLd?: unknown
}

const { seo, pageTitle, jsonLd } = Astro.props
const settings = await getGlobal('site-settings')
const eggData = await getEggData()

const template =
  settings.defaultSeo?.titleTemplate ?? `%s | ${settings.siteName ?? 'Sebastian Titz'}`
const title = seo?.title
  ? seo.title
  : pageTitle
    ? template.replace('%s', pageTitle)
    : (settings.defaultSeo?.title ?? settings.siteName ?? 'Sebastian Titz')
const description = seo?.description ?? settings.defaultSeo?.description ?? ''

const ogQuelle = seo?.image ?? settings.defaultSeo?.image
const og = ogBild(ogQuelle)
const ogImage = og?.url
// Der Alt-Text kommt aus der Mediathek; ohne Eintrag der Seitentitel, der die
// Person und den Ort nennt und damit die Aufgabe erfüllt.
const ogImageAlt =
  (typeof ogQuelle === 'object' ? ogQuelle?.alt : null) || (settings.siteName ?? 'Sebastian Titz')
const canonical = new URL(
  Astro.url.pathname,
  settings.domain ?? Astro.site ?? 'https://titz.cooking',
)
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {seo?.noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.siteName ?? 'Sebastian Titz'} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {
      /* Masse und Alt-Text zum Vorschaubild. Ohne `og:image:width`/`:height`
         rendert Facebook den ersten Share als kleine Kachel, weil es das Bild
         zu diesem Zeitpunkt noch nicht geholt hat — beim zweiten stimmt es
         dann, was den Fehler schwer auffindbar macht. Die Werte sind fest:
         Das Bild wird unten auf genau dieses Format zugeschnitten. */
    }
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          {og?.zugeschnitten && (
            <>
              <meta property="og:image:width" content="1200" />
              <meta property="og:image:height" content="630" />
            </>
          )}
          <meta property="og:image:alt" content={ogImageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      /* Die Bilder liegen auf dem CMS-Worker, also einer anderen Herkunft.
         Ohne diesen Hinweis beginnt der Browser DNS, TLS und Verbindung erst,
         wenn er das erste <img> im Dokument erreicht. */
    }
    <link rel="preconnect" href={new URL(PAYLOAD_ORIGIN).origin} crossorigin />
    <link rel="dns-prefetch" href={new URL(PAYLOAD_ORIGIN).origin} />
    {
      /* Die Schrift liegt seit dem 02.09.2026 bei uns, nicht bei Google —
         Begründung in `styles/global.css`. Der Preload zieht sie parallel zum
         CSS, statt zu warten, bis der Parser die @font-face-Regel erreicht:
         Das LCP-Element dieser Seite ist die Überschrift, der Font liegt also
         auf dem kritischen Pfad. */
    }
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {
      /* Vor dem Inhalt stehen Marke, sechs Navigationslinks und der
         Reservieren-Button — dazu über die Seite verteilt 23 Gemüse-Buttons
         des Easter-Egg-Spiels. Ohne diesen Sprung arbeitet sich jede
         Tastaturnavigation und jeder Screenreader jedes Mal durch alles
         hindurch. Sichtbar wird der Link erst bei Fokus. */
    }
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline type="application/json" id="egg-data" set:html={JSON.stringify(eggData)} />
    <script src="../scripts/playful.ts"></script>
  </body>
</html>
