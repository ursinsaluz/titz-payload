---
import { getEggData, getGlobal, mediaUrl, type Page } from '../lib/payload'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import { PAYLOAD_ORIGIN } from '../lib/payload'

interface Props {
  /** Die SEO-Gruppe der Seite, direkt aus dem Content-Modell — vorher hier
      nachgebaut und mit `as never` übergeben. */
  seo?: Page['seo']
  pageTitle?: string
  /** Strukturierte Daten. Nur die Startseite hat welche; Impressum und
      Datenschutz brauchen keine und bekommen darum keine leere Angabe. */
  jsonLd?: unknown
}

const { seo, pageTitle, jsonLd } = Astro.props
const settings = await getGlobal('site-settings')
const eggData = await getEggData()

const template =
  settings.defaultSeo?.titleTemplate ?? `%s | ${settings.siteName ?? 'Sebastian Titz'}`
const title = seo?.title
  ? seo.title
  : pageTitle
    ? template.replace('%s', pageTitle)
    : (settings.defaultSeo?.title ?? settings.siteName ?? 'Sebastian Titz')
const description = seo?.description ?? settings.defaultSeo?.description ?? ''
const ogImage = mediaUrl(seo?.image) ?? mediaUrl(settings.defaultSeo?.image)
const canonical = new URL(
  Astro.url.pathname,
  settings.domain ?? Astro.site ?? 'https://titz.cooking',
)
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {seo?.noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.siteName ?? 'Sebastian Titz'} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      /* Die Bilder liegen auf dem CMS-Worker, also einer anderen Herkunft.
         Ohne diesen Hinweis beginnt der Browser DNS, TLS und Verbindung erst,
         wenn er das erste <img> im Dokument erreicht. */
    }
    <link rel="preconnect" href={new URL(PAYLOAD_ORIGIN).origin} crossorigin />
    <link rel="dns-prefetch" href={new URL(PAYLOAD_ORIGIN).origin} />
    {
      /* Die Schrift liegt seit dem 02.09.2026 bei uns, nicht bei Google —
         Begründung in `styles/global.css`. Der Preload zieht sie parallel zum
         CSS, statt zu warten, bis der Parser die @font-face-Regel erreicht:
         Das LCP-Element dieser Seite ist die Überschrift, der Font liegt also
         auf dem kritischen Pfad. */
    }
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline type="application/json" id="egg-data" set:html={JSON.stringify(eggData)} />
    <script src="../scripts/playful.ts"></script>
  </body>
</html>
