---
import Base from '../../layouts/Base.astro'
import Brotkrume from '../../components/Brotkrume.astro'
import { getCollection, getGlobal, mediaUrl } from '../../lib/payload'
import { hatLexicalInhalt, lexicalToHtml } from '../../lib/lexical'
import { aktuellesPfad, aktuellesSeitenSchema, aktuellesSlug } from '../../lib/schema'

/**
 * Detailseite für eigene Beiträge unter «Aktuelles».
 *
 * Einträge in `news`, die nur auf externe Presseberichte verweisen, haben
 * keinen `body` und führen direkt zur Quelle. Eigene Beiträge — etwa zu
 * Produkten mit Produzenten aus Fläsch oder Einblicken aus Küche und Garten —
 * tragen ihren Inhalt in `body` und bekommen hier ihre eigene Adresse.
 */
export async function getStaticPaths() {
  const eintraege = await getCollection('news', '&sort=-date&where[_status][equals]=published')
  return eintraege
    .filter((eintrag) => hatLexicalInhalt(eintrag.body))
    .map((artikel) => {
      const slug = aktuellesSlug(artikel.title)
      return { params: { slug }, props: { artikel, slug } }
    })
}

const { artikel, slug } = Astro.props
const settings = await getGlobal('site-settings')
const domain = settings.domain ?? 'https://titz.cooking'

const datum = artikel.date
  ? new Date(artikel.date).toLocaleDateString('de-CH', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : null

const vorschaubild = mediaUrl(artikel.image, { breite: 760 })
const jsonLd = aktuellesSeitenSchema(artikel, slug, domain, vorschaubild)

const eigenerPfad = aktuellesPfad(slug)
const externerLink = artikel.link?.url && artikel.link.url !== eigenerPfad ? artikel.link : null
---

<Base
  seo={{
    title: `${artikel.title} | ${settings.siteName ?? 'Sebastian Titz'}`,
    description: artikel.excerpt,
    image: artikel.image,
  }}
  pageTitle={artikel.title}
  jsonLd={jsonLd}
>
  <article class="detail">
    <div class="detail__inner">
      <Brotkrume
        eintraege={[
          { name: 'Start', pfad: '/' },
          { name: 'Aktuelles', pfad: '/#aktuelles' },
          { name: artikel.title, pfad: eigenerPfad },
        ]}
      />

      <div class="detail__meta">
        {artikel.badge && <span class="eyebrow">{artikel.badge}</span>}
        {
          datum && (
            <time class="detail__datum" datetime={String(artikel.date).slice(0, 10)}>
              {datum}
            </time>
          )
        }
      </div>

      <h1>{artikel.title}</h1>

      <p class="detail__lead">{artikel.excerpt}</p>

      {
        artikel.body && (
          <div
            class="detail__text"
            set:html={lexicalToHtml(artikel.body, { videoPoster: vorschaubild ?? undefined })}
          />
        )
      }

      {
        externerLink?.url && (
          <a
            class="pill pill--dark detail__cta"
            href={externerLink.url}
            target={externerLink.url.startsWith('http') ? '_blank' : undefined}
            rel={externerLink.url.startsWith('http') ? 'noopener' : undefined}
          >
            {externerLink.label ?? 'Mehr erfahren'}
          </a>
        )
      }
    </div>
  </article>
</Base>

<style>
  .detail {
    padding: 60px 40px 90px;
  }

  .detail__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .detail__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
  }

  .detail__datum {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .detail h1 {
    margin: 10px 0 0;
    font-size: clamp(30px, 4.6vw, 44px);
    letter-spacing: -0.015em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .detail__lead {
    margin: 26px 0 0;
    font-size: 18px;
    line-height: 1.65;
  }

  .detail__text {
    margin-top: 28px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink);
  }

  .detail__text :global(p) {
    margin: 0 0 18px;
  }

  .detail__text :global(h2) {
    margin: 40px 0 10px;
    font-size: 22px;
    letter-spacing: -0.01em;
  }

  .detail__text :global(.richtext-media) {
    margin: 22px 0 32px;
  }

  .detail__text :global(.richtext-media img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1.5px solid var(--rule);
    background: #fff;
  }

  .detail__text :global(.richtext-media--video) {
    max-width: 384px;
    margin-left: auto;
    margin-right: auto;
  }

  .detail__text :global(.richtext-media video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    border: 1.5px solid var(--rule);
    background: #1a1d1f;
  }

  .detail__text :global(.richtext-media figcaption) {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .detail__cta {
    margin-top: 36px;
  }

  @media (max-width: 720px) {
    .detail {
      padding: 40px 24px 70px;
    }
  }
</style>
