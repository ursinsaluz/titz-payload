# Cache-Regeln für alles, was Workers als statisches Asset ausliefert.
#
# Workers Assets setzt von sich aus `public, max-age=0, must-revalidate` auf
# JEDE Datei — gemessen am 31.08.2026 auch auf `/_astro/*`. Diese Dateien tragen
# den Inhaltshash im Namen, ihr Inhalt kann sich also nie ändern; der
# Revalidierungs-Roundtrip pro Aufruf ist dort reine Verschwendung.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Logo und Favicon behalten ihren Namen über Deploys hinweg, darum kein
# `immutable`. Ein Tag Browser-Cache statt Nachfragen bei jedem Seitenaufruf.
/titz-mark.svg
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# Für HTML bleibt der Standard (`max-age=0, must-revalidate`) bewusst stehen:
# Cloudflare hält die Seiten am Rand — `cf-cache-status: HIT` — und der Browser
# fragt mit ETag nach, was auf ein 304 hinausläuft. Ein `s-maxage` würde nach
# einem Rebuild den alten Stand weiterliefern, und ohne Purge-Token gibt es
# nichts, was den Rand vorher leeren könnte.
