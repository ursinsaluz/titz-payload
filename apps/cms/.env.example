# A generated secret for Payload
PAYLOAD_SECRET=

# Deploy-Hook des Workers `titz-payload-web` (Cloudflare-Dashboard → Worker →
# Settings → Builds → Deploy Hooks). Löst nach jeder Inhaltsänderung einen
# Frontend-Build aus — siehe src/hooks/rebuildWeb.ts.
# In Produktion als Secret setzen, nicht als `vars`:
#   wrangler secret put WEB_DEPLOY_HOOK_URL
# Lokal leer lassen, sonst baut jedes Speichern die Live-Seite neu.
WEB_DEPLOY_HOOK_URL=

# Schlüssel aus der Collection «MCP-Schlüssel» im Admin (Gruppe «System»).
# Wird von .mcp.json im Repo-Root als Bearer-Token gelesen — nie den Schlüssel
# selbst in .mcp.json schreiben, die Datei ist eingecheckt.
PAYLOAD_MCP_TOKEN=
