{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "titz-payload-admin",
  // D1 antwortet aus EEUR (Mailand), und das Admin macht viele
  // aufeinanderfolgende Abfragen je Seitenaufruf. Smart Placement rückt den
  // Worker näher an die Datenbank. Es braucht anhaltenden Verkehr, um zu lernen
  // — bei diesem Admin kann es also auch nichts tun. Kostet nichts, ist mit
  // einer Zeile zurückgedreht, und der Vergleich läuft über die TTFB von
  // `/admin`.
  "placement": { "mode": "smart" },

  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // Ohne das behält Cloudflare nichts. Die Konfiguration schreibt einen eigenen
  // Logger (`cloudflareLogger` in src/payload.config.ts), der in Produktion
  // strukturiertes JSON ausgibt — und `rebuildWeb.ts` meldet dort, wenn der
  // Deploy-Hook fehlschlägt. Mit abgeschalteten Logs wäre genau diese Meldung
  // unsichtbar, und eine Änderung würde einfach nicht live gehen.
  //
  // Gehört in diese Datei und nicht bloss ins Dashboard: `wrangler deploy`
  // schreibt die Worker-Einstellungen von hier, ein dort gesetzter Schalter
  // wäre beim nächsten Deploy wieder weg.
  //
  // Der äussere Schalter steht auf `false`, die einzelnen darunter auf `true` —
  // dieselbe Form wie in `alvier-payload`, wo sie sich bewährt hat: Die
  // spezifischen Angaben für Logs und Traces haben Vorrang.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },

  // Ausgehende Mail über Cloudflare Email Sending. Bewusst **ohne**
  // `"remote": true`: Sonst verschickt jedes `next dev` echte Nachrichten an
  // echte Adressen. Lokal fehlt das Binding damit, und der Adapter in
  // `src/email/cloudflareEmail.ts` protokolliert die Nachricht statt sie zu
  // senden — der Link zum Zurücksetzen steht dann im Terminal. Wer einen echten
  // Versand testen will, setzt das Flag für einen Lauf und nimmt es zurück.
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],

  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "da276be8-d212-442f-9c0d-7ef25c327e3b",
      "database_name": "titz-payload-site",
      "remote": true,
    },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "my-app"
    // },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "titz-payload-media",
      "preview_bucket_name": "titz-payload-media",
      // Wrangler schaltet Remote-Bindings **pro Binding** frei. Beim D1 stand
      // das Flag, beim R2 nicht — deshalb schrieb jeder Lauf gegen Produktion
      // die Datenbankzeilen nach remote und die Dateien ins lokale Bucket unter
      // `.wrangler/`. Genau so entstand am 06.07.2026 der Zustand, in dem alle
      // Bilder auf titz.cooking mit 404 antworteten, obwohl die Datensätze
      // vollständig aussahen.
      //
      // Wirkt nur, wenn `remoteBindings` gesetzt ist (siehe payload.config.ts):
      // im deployten Worker sind die Bindings ohnehin echt, und ein einfaches
      // `pnpm dev:cms` bleibt komplett lokal.
      "remote": true,
    },

    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // Here's how to configure an additional environment
  // It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
  // "env": {
  //   "staging": {
  //     "name": "my-app-staging",
  //     "d1_databases": [
  //       {
  //         "binding": "D1",
  //         "database_id": "DATABASE_ID",
  //         "database_name": "my-app-staging",
  //         "remote": true
  //       }
  //     ],
  //     "services": [
  //       // The service should match the "name" of your worker
  //       // {
  //       //   "binding": "WORKER_SELF_REFERENCE",
  //       //   "service": "my-app-staging"
  //       // },
  //     ],
  //     "r2_buckets": [
  //       {
  //         "binding": "R2",
  //         "bucket_name": "my-app-staging"
  //       }
  //       // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
  //       // {
  //       //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //       //   "bucket_name": "<BUCKET_NAME>",
  //       // },
  //     ]
  //   }
  // }
}
