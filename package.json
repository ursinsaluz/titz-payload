{
  "name": "titz-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --parallel --filter @titz/cms --filter @titz/web run dev",
    "dev:cms": "pnpm --filter @titz/cms run dev",
    "dev:web": "pnpm --filter @titz/web run dev",
    "dev:cms:remote": "pnpm --filter @titz/cms run dev:remote",
    "build": "pnpm --filter @titz/cms run build && pnpm --filter @titz/web run build",
    "deploy:cms": "pnpm --filter @titz/cms run deploy",
    "deploy:web": "pnpm --filter @titz/web run deploy",
    "seed": "pnpm --filter @titz/cms run seed",
    "generate:types": "pnpm --filter @titz/cms run generate:types",
    "migrate:status": "pnpm --filter @titz/cms run migrate:status",
    "migrate:status:prod": "pnpm --filter @titz/cms run migrate:status:prod",
    "check": "pnpm --filter @titz/cms exec tsc --noEmit && pnpm --filter @titz/web run check",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm security:scan && pnpm format:check && pnpm lint && pnpm check && pnpm build && pnpm test",
    "security:scan": "scripts/secret-scan.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  },
  "packageManager": "pnpm@10.32.1"
}
