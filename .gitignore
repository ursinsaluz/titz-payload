# dependencies
node_modules/

# testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# next.js / astro build output
.next/
out/
dist/
.astro/

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# debug
*.log

# env
.env
.env*.local
# Lokale Secrets für `wrangler dev` — dieselbe Rolle wie .env, anderer Name.
# Ohne diese Zeile landet ein PAYLOAD_SECRET beim ersten `wrangler dev` im Repo,
# und das Repo ist öffentlich.
.dev.vars
.dev.vars.*

# Schlüssel und Zertifikate
*.key
*.p12
*.pfx
id_rsa*

# payload local media (uploads landen in R2; lokal nur Fallback)
apps/cms/media/

# OpenNext / Cloudflare
.open-next/
.wrangler/

# Next 16 schreibt bei jedem `next dev` ein AGENTS.md und CLAUDE.md in die App
# (`agentRules`). In next.config.ts ist das abgeschaltet — die Regel hier ist die
# zweite Sicherung: Die verbindlichen Anweisungen stehen im Wurzelverzeichnis,
# und zwei automatisch erzeugte Dateien daneben würden ihnen widersprechen.
apps/cms/AGENTS.md
apps/cms/CLAUDE.md

# Werkzeuge, die pro Maschine schreiben
.idea/
.claude/settings.local.json
